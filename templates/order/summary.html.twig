

{% extends 'base.html.twig' %}


{% block body %}
    <div class="container my-5">
        <h1 class="text-center">Mon panier</h1>
        <div class="row">
            <div class="col-md-8">
                <div class="bg-light p-3">
                    <strong>Le contenu de mon panier</strong>
                    {% for product in cart%}
                        <div class="row mt-2">
                            <div class="col-md-2">
                                <img src="/uploads/{{product.object.illustration}}" class="img-fluid" alt={{product.object.name}}/>
                            </div>
                            <div class="col-md-6">
                                <strong>{{product.object.name}}</strong>
                                <span>{{product.object.getPriceWithTaxe|price}}</span>
                            </div>
                            <div class="col-md-2 text-right">
                                <span class="badge text-bg-secondary">{{product.qty}}</span>
                            </div>
                            <div class="col-md-2 text-right">
                                <strong class="badge text-bg-secondary">{{product.qty * product.object.getPriceWithTaxe}}</strong>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <div class="bg-light p-3 my-3">
                    <strong>Votre addresse de livraison:  </strong><br/>
                    {#  on a addresses par rapport a la relation dans nos modeles  #}
                    {{choices.address.firstName}}
                    {{choices.address.lastName}}
                    {{choices.address.address}}
                    {{choices.address.city}}
                    {{choices.address.country}}
                </div>
                <div class="bg-light p-3 my-3">
                    <strong>Votre transporteur :  </strong><br/>
                    {#  on a carriers par rapport a la relation dans nos modeles  #}
                    {{choices.carriers.name}}
                    {{choices.carriers.description}}
                </div>
            
            </div>
            <div class="col-md-4">
                <div class="bg-light p-3 shadow-sm">
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold">Total Produit</span>
                        <span>{{fullCartQuantity}}</span>
                    </div>
                    <div class="d-flex justify-content-between mt-3">
                        <span class="fw-bold">Total transporteur </span>
                        <span>{{choices.carriers.price| price}}</span>
                    </div>
                    <div class="d-flex justify-content-between mt-3">
                        <span class="fw-bold">Total commande </span>
                        <span>{{choices.carriers.price + totalWt |price}}</span>
                    </div>
                </div>
                <a href="{{path('app_order_summary')}}" class="btn btn-success w-100">Payer</a>  
            </div>
        </div>

    </div>
{% endblock %}